@page "/Reservations"
@model RestaurantReservationAndOrderManagementSystem.Pages.ReservationsModel
@{
    ViewData["Title"] = "Reservations";
}

<link rel="stylesheet" href="~/css/reservations_page.css" asp-append-version="true" />

<section class="reservations-page" aria-label="Reservation management">
    <header class="reservation-hero">
        <div>
            <p class="eyebrow">The reservation book</p>
            <h1>Who's joining us?</h1>
            <p class="hero-caption">Keep the room feeling easy, one booking at a time.</p>
        </div>
        <button class="new-reservation-button" type="button">
            <i class="fa-solid fa-plus" aria-hidden="true"></i>
            New reservation
        </button>
    </header>

    <section class="reservation-stats" aria-label="Reservation summary">
        <article class="summary-card">
            <i class="fa-regular fa-calendar-days" aria-hidden="true"></i>
            <div><strong>8</strong><span>bookings today</span></div>
        </article>
        <article class="summary-card">
            <i class="fa-solid fa-user-group" aria-hidden="true"></i>
            <div><strong>20</strong><span>guests expected</span></div>
        </article>
        <article class="summary-card">
            <i class="fa-solid fa-table-cells" aria-hidden="true"></i>
            <div><strong>4</strong><span>tables still free</span></div>
        </article>
    </section>

    <form class="reservation-filters" role="search">
        <label class="search-control">
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
            <span class="visually-hidden">Search guests or tables</span>
            <input type="search" placeholder="Search guests or tables..." />
        </label>
        <label class="date-control">
            <i class="fa-regular fa-calendar-days" aria-hidden="true"></i>
            <span class="visually-hidden">Filter by reservation date</span>
            <input type="date" value="2026-10-17" />
        </label>
    </form>

    <section class="reservation-list-panel" aria-labelledby="reservation-list-title">
        <div class="list-heading">
            <div>
                <p class="eyebrow">Friday service</p>
                <h2 id="reservation-list-title">Reservation list</h2>
            </div>
            <span class="booking-count">5 bookings</span>
        </div>

        <div class="reservation-table-wrap">
            <table class="reservation-table" aria-label="Friday reservation list">
                <thead class="visually-hidden">
                    <tr>
                        <th scope="col">Time and date</th>
                        <th scope="col">Guest</th>
                        <th scope="col">Guests</th>
                        <th scope="col">Table</th>
                        <th scope="col">Status</th>
                        <th scope="col">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="time-cell"><span class="time-info"><strong>12:30 PM</strong><span>Oct 17, 2026</span></span></td>
                        <td class="guest-cell"><span class="guest-profile"><span class="guest-avatar">JD</span><span class="guest-info"><strong>John Doe</strong><small>012-3456789</small></span></span></td>
                        <td data-label="Guests">4 guests</td>
                        <td data-label="Table">Table 7</td>
                        <td><span class="booking-status status-arriving">Arriving</span></td>
                        <td class="action-cell"><button type="button" class="edit-button" aria-label="Edit John Doe reservation"><i class="fa-regular fa-pen-to-square" aria-hidden="true"></i></button></td>
                    </tr>
                    <tr>
                        <td class="time-cell"><span class="time-info"><strong>1:00 PM</strong><span>Oct 17, 2026</span></span></td>
                        <td class="guest-cell"><span class="guest-profile"><span class="guest-avatar">JS</span><span class="guest-info"><strong>Jane Smith</strong><small>098-7654321</small></span></span></td>
                        <td data-label="Guests">2 guests</td>
                        <td data-label="Table">Table 3</td>
                        <td><span class="booking-status status-confirmed">Confirmed</span></td>
                        <td class="action-cell"><button type="button" class="edit-button" aria-label="Edit Jane Smith reservation"><i class="fa-regular fa-pen-to-square" aria-hidden="true"></i></button></td>
                    </tr>
                    <tr>
                        <td class="time-cell"><span class="time-info"><strong>6:00 PM</strong><span>Oct 17, 2026</span></span></td>
                        <td class="guest-cell"><span class="guest-profile"><span class="guest-avatar">TL</span><span class="guest-info"><strong>Tim Lee</strong><small>011-2233445</small></span></span></td>
                        <td data-label="Guests">6 guests</td>
                        <td data-label="Table">Table 1</td>
                        <td><span class="booking-status status-dining">On dine-in</span></td>
                        <td class="action-cell"><button type="button" class="edit-button" aria-label="Edit Tim Lee reservation"><i class="fa-regular fa-pen-to-square" aria-hidden="true"></i></button></td>
                    </tr>
                    <tr>
                        <td class="time-cell"><span class="time-info"><strong>7:30 PM</strong><span>Oct 17, 2026</span></span></td>
                        <td class="guest-cell"><span class="guest-profile"><span class="guest-avatar">MG</span><span class="guest-info"><strong>Maria Gomez</strong><small>022-3344556</small></span></span></td>
                        <td data-label="Guests">3 guests</td>
                        <td data-label="Table">Table 5</td>
                        <td><span class="booking-status status-confirmed">Confirmed</span></td>
                        <td class="action-cell"><button type="button" class="edit-button" aria-label="Edit Maria Gomez reservation"><i class="fa-regular fa-pen-to-square" aria-hidden="true"></i></button></td>
                    </tr>
                    <tr>
                        <td class="time-cell"><span class="time-info"><strong>8:00 PM</strong><span>Oct 17, 2026</span></span></td>
                        <td class="guest-cell"><span class="guest-profile"><span class="guest-avatar">AP</span><span class="guest-info"><strong>Arun Patel</strong><small>033-4455667</small></span></span></td>
                        <td data-label="Guests">5 guests</td>
                        <td data-label="Table">Table 2</td>
                        <td><span class="booking-status status-confirmed">Waiting</span></td>
                        <td class="action-cell"><button type="button" class="edit-button" aria-label="Edit Arun Patel reservation"><i class="fa-regular fa-pen-to-square" aria-hidden="true"></i></button></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>
</section>
