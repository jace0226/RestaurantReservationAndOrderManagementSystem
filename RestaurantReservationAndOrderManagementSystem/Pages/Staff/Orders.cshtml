@page "/Staff/Orders"
@model RestaurantReservationAndOrderManagementSystem.Pages.OrdersModel
@{
    ViewData["Title"] = "Orders";
}

<link rel="stylesheet" href="~/css/orders_page.css" asp-append-version="true" />

<section class="orders-page" aria-label="Order management">
    <header class="orders-hero">
        <div>
            <p class="eyebrow">Fresh from the kitchen</p>
            <h1>Orders at a glance</h1>
            <p class="hero-caption">Follow each order from the first ticket to the final handoff.</p>
        </div>
        <div class="orders-hero-count" aria-live="polite">
            <strong>@Model.Orders.Count</strong>
            <span>@(Model.StatusFilter == "All" ? "orders" : $"{Model.StatusFilter.ToLowerInvariant()} orders")</span>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.PaymentSuccess))
    {
        <div class="alert alert-success" role="status">@Model.PaymentSuccess</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.PaymentError))
    {
        <div class="alert alert-danger" role="alert">@Model.PaymentError</div>
    }

    <section class="orders-list-panel" aria-label="Order queue">
        <div class="orders-toolbar">
            <div class="list-heading">
                <div>
                    <p class="eyebrow">Order queue</p>
                    <h2>Orders (@Model.SelectedDate.ToString("dd/MM/yyyy"))</h2>
                </div>
            </div>
            <form method="get" asp-page="/Staff/Orders" class="orders-date-filter">
                <div class="date-control">
                    <i class="fa-regular fa-calendar-days" aria-hidden="true"></i>
                    <label for="selectedDate" class="visually-hidden">Select date</label>
                    <input id="selectedDate"
                           type="date"
                           name="selectedDate"
                           value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                </div>
                <input type="hidden" name="statusFilter" value="@Model.StatusFilter" />
                <button class="filter-submit" type="submit">Filter</button>
            </form>
            <nav class="filter-nav" aria-label="Order status filters">
                <a asp-page="/Staff/Orders" asp-route-statusFilter="All" asp-route-selectedDate="@Model.SelectedDate.ToString("yyyy-MM-dd")"
                   aria-pressed="@(Model.StatusFilter == "All")">All</a>
                @foreach (var status in Model.Statuses)
                {
                    <a asp-page="/Staff/Orders" asp-route-statusFilter="@status" asp-route-selectedDate="@Model.SelectedDate.ToString("yyyy-MM-dd")"
                       aria-pressed="@(Model.StatusFilter.Equals(status, StringComparison.OrdinalIgnoreCase))">@status</a>
                }
            </nav>
        </div>

        <div class="order-main">
            <aside class="order-list" aria-label="Orders">
                @if (Model.Orders.Count == 0)
                {
                    <p class="empty-orders">No orders found for this status.</p>
                }
                @foreach (var order in Model.Orders)
                {
                    var isSelected = order.OrderId == Model.SelectedOrder?.OrderId;
                    <a class="order-card @(isSelected ? "selected" : null)"
                       asp-page="/Staff/Orders"
                       asp-route-orderId="@order.OrderId"
                       asp-route-statusFilter="@Model.StatusFilter"
                       asp-route-selectedDate="@Model.SelectedDate.ToString("yyyy-MM-dd")"
                       aria-current="@(isSelected ? "true" : null)">
                        <div class="order-card-header">
                            <span class="order-id">Order #@order.OrderId</span>
                            <time class="order-time" datetime="@order.CreatedAt.ToString("O")">
                                @order.CreatedAt.ToString("h:mm tt")
                            </time>
                        </div>
                        <div class="order-card-body">
                            <span><i class="fa-solid fa-chair" aria-hidden="true"></i> Table @order.TableId</span>
                            <span><i class="fa-solid fa-utensils" aria-hidden="true"></i> @order.ItemCount items</span>
                        </div>
                        <div class="order-card-footer">
                            <div>
                                <span class="order-total">RM @order.Total.ToString("N2")</span>
                                @if (order.HasPromotions)
                                {
                                    <span class="order-promo-badge" title="Order includes promotional discount">
                                        <i class="fa-solid fa-tag" aria-hidden="true"></i> Promo
                                    </span>
                                }
                            </div>
                            <span class="status-badge">@order.Status</span>
                        </div>
                    </a>
                }
            </aside>

            @if (Model.SelectedOrder is { } selectedOrder)
            {
                <section class="order-detail-panel" aria-label="Selected order details">
                    <header class="detail-header">
                        <div class="detail-heading">
                            <div>
                                <p class="eyebrow">Order details</p>
                                <h2>@selectedOrder.CustomerName</h2>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                @if (selectedOrder.HasPromotions)
                                {
                                    <span class="promo-badge-pill" title="Order received special promotional pricing">
                                        <i class="fa-solid fa-tags" aria-hidden="true"></i> Promo Applied
                                    </span>
                                }
                                <span class="status-badge">@selectedOrder.Status</span>
                            </div>
                        </div>
                        <p class="detail-order-id">#@selectedOrder.OrderId</p>
                        <div class="detail-meta">
                            <span><i class="fa-solid fa-chair" aria-hidden="true"></i> Table @selectedOrder.TableId</span>
                            <time datetime="@selectedOrder.CreatedAt.ToString("O")">
                                <i class="fa-regular fa-clock" aria-hidden="true"></i>
                                @selectedOrder.CreatedAt.ToString("h:mm tt")
                            </time>
                        </div>
                    </header>

                    <div class="order-items" role="list" aria-label="Items in this order">
                        @if (selectedOrder.Items.Count == 0)
                        {
                            <p class="empty-orders">This order has no items.</p>
                        }
                        @foreach (var item in selectedOrder.Items)
                        {
                            <div class="order-item" role="listitem">
                                <span class="item-icon" aria-hidden="true"><i class="fa-solid fa-utensils"></i></span>
                                <div class="item-meta">
                                    <div class="d-flex align-items-center">
                                        <span class="item-name">@item.Name</span>
                                        @if (item.HasPromotion)
                                        {
                                            <span class="item-promo-tag" title="Promotional item">
                                                <i class="fa-solid fa-tag" aria-hidden="true"></i> PROMO
                                            </span>
                                        }
                                    </div>
                                    <span class="item-quantity">
                                        @if (item.HasPromotion)
                                        {
                                            <span>
                                                @item.Quantity × 
                                                <del class="item-orig-price">RM @item.OriginalUnitPrice.ToString("N2")</del>
                                                <span class="item-promo-price">RM @item.EffectiveUnitPrice.ToString("N2")</span>
                                                <span class="item-savings-text">(Save RM @item.LineDiscount.ToString("N2"))</span>
                                            </span>
                                        }
                                        else
                                        {
                                            <span>@item.Quantity × RM @item.OriginalUnitPrice.ToString("N2")</span>
                                        }
                                    </span>
                                </div>
                                <strong class="item-line-total">RM @item.LineTotal.ToString("N2")</strong>
                            </div>
                        }
                    </div>

                    <!-- ORDER COST BREAKDOWN REDESIGN -->
                    <div class="order-breakdown">
                        @if (selectedOrder.HasPromotions)
                        {
                            <div class="breakdown-row">
                                <span>Original Subtotal</span>
                                <span>RM @selectedOrder.OriginalSubtotal.ToString("N2")</span>
                            </div>
                            <div class="breakdown-row discount-row">
                                <span><i class="fa-solid fa-tag" aria-hidden="true"></i> Promotion Discount</span>
                                <span>- RM @selectedOrder.TotalDiscount.ToString("N2")</span>
                            </div>
                            <div class="breakdown-row">
                                <span>Subtotal (After Promo)</span>
                                <span>RM @selectedOrder.NetSubtotal.ToString("N2")</span>
                            </div>
                        }
                        else
                        {
                            <div class="breakdown-row">
                                <span>Subtotal</span>
                                <span>RM @selectedOrder.NetSubtotal.ToString("N2")</span>
                            </div>
                        }
                        <div class="breakdown-row">
                            <span>Service Tax (10%)</span>
                            <span>RM @selectedOrder.Tax.ToString("N2")</span>
                        </div>
                        <div class="breakdown-row total-row">
                            <span>@(selectedOrder.HasRecordedTotal ? "Recorded Transaction Total" : "Order Total Amount")</span>
                            <strong>RM @selectedOrder.Total.ToString("N2")</strong>
                        </div>
                        <div class="breakdown-row">
                            <span>Payment method</span>
                            <strong>@(selectedOrder.RecordedPaymentMethod ?? (selectedOrder.PaymentMethod == "Counter" ? "Pay at counter" : selectedOrder.PaymentMethod ?? "Not specified"))</strong>
                        </div>
                        <div class="breakdown-row">
                            <span>Payment status</span>
                            <strong>@(selectedOrder.HasRecordedTotal ? "Paid" : selectedOrder.Status == "Payment" && selectedOrder.PaymentMethod == "Counter" ? "Awaiting counter payment" : selectedOrder.Status == "Payment" ? "Awaiting Stripe payment" : "Not paid")</strong>
                        </div>
                        @if (selectedOrder.TenderedAmount.HasValue)
                        {
                            <div class="breakdown-row">
                                <span>Amount tendered</span>
                                <strong>RM @selectedOrder.TenderedAmount.Value.ToString("N2")</strong>
                            </div>
                            <div class="breakdown-row">
                                <span>Change given</span>
                                <strong>RM @selectedOrder.ChangeGiven.Value.ToString("N2")</strong>
                            </div>
                        }

                        @if (selectedOrder.HasPromotions)
                        {
                            <div class="order-savings-callout">
                                <i class="fa-solid fa-gift" aria-hidden="true"></i>
                                <span>Total promotional savings for this order: RM @selectedOrder.TotalDiscount.ToString("N2")</span>
                            </div>
                        }
                    </div>

                    @if (selectedOrder.Status == "Payment" &&
                         selectedOrder.PaymentMethod == "Counter" &&
                         !selectedOrder.HasRecordedTotal)
                    {
                        <form method="post" asp-page-handler="RecordCounterPayment" class="order-status-form">
                            <input type="hidden" name="orderId" value="@selectedOrder.OrderId" />
                            <input type="hidden" name="statusFilter" value="@Model.StatusFilter" />
                            <input type="hidden" name="selectedDate" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                            <label for="counter-tendered-amount">Amount received (RM)</label>
                            <div class="status-form-controls">
                                <input id="counter-tendered-amount"
                                       name="tenderedAmount"
                                       type="number"
                                       min="@selectedOrder.Total.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                       step="0.01"
                                       required
                                       aria-describedby="counter-payment-help" />
                                <button type="submit">Record payment</button>
                            </div>
                            <small id="counter-payment-help">Amount due: RM @selectedOrder.Total.ToString("N2"). Change is calculated and saved when payment is recorded.</small>
                        </form>
                    }

                    <form method="post" asp-page-handler="UpdateStatus" class="order-status-form">
                        <input type="hidden" name="orderId" value="@selectedOrder.OrderId" />
                        <input type="hidden" name="statusFilter" value="@Model.StatusFilter" />
                        <input type="hidden" name="selectedDate" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                        <label for="order-status">Update order status</label>
                        <div class="status-form-controls">
                            <select id="order-status" name="status">
                                @foreach (var status in Model.Statuses)
                                {
                                    <option value="@status" selected="@(selectedOrder.Status.Equals(status, StringComparison.OrdinalIgnoreCase))">
                                        @status
                                    </option>
                                }
                            </select>
                            <button type="submit">Save status</button>
                        </div>
                    </form>
                </section>
            }
        </div>
    </section>
</section>
