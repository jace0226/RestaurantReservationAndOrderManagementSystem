@page "/Staff/Tables"
@model RestaurantReservationAndOrderManagementSystem.Pages.TablesModel
@{
    ViewData["Title"] = "Tables";
}

<link rel="stylesheet" href="~/css/tables_page.css" asp-append-version="true" />

<section class="tables-page" aria-label="Table management">
    <header class="tables-hero">
        <div>
            <p class="eyebrow">The room at a glance</p>
            <h1>Tables at a glance</h1>
            <p class="hero-caption">Manage table capacity and availability.</p>
        </div>
        <div class="tables-hero-actions">
            <div class="tables-hero-count" aria-live="polite">
                <strong>@Model.Tables.Count</strong>
                <span>@(Model.StatusFilter == "All" ? "tables" : $"{Model.StatusFilter.ToLowerInvariant()} tables")</span>
            </div>
            @if (User.IsInRole("Administrator"))
            {
                <button class="add-table-button" type="button" id="openAddTableModal">
                <i class="fa-solid fa-plus" aria-hidden="true"></i>
                Add table
                </button>
            }
        </div>
    </header>

    @if (TempData["TableMessage"] is string tableMessage)
    {
        <div class="table-success-message" role="status">@tableMessage</div>
    }

    <div asp-validation-summary="ModelOnly" class="text-danger table-validation-summary" role="alert"></div>

    <section class="tables-list-panel" aria-label="Table overview">
        <div class="tables-toolbar">
            <div class="tables-toolbar-heading">
                <p class="eyebrow">Floor overview</p>
                <h2>Find a table</h2>
            </div>
            <div class="tables-toolbar-actions">
                <div class="status-legend" aria-label="Table status counts">
                    <span class="legend-item"><i class="legend-dot legend-available" aria-hidden="true"></i>Available <strong>@Model.AvailableTables</strong></span>
                    <span class="legend-item"><i class="legend-dot legend-reserved" aria-hidden="true"></i>Reserved <strong>@Model.ReservedTables</strong></span>
                    <span class="legend-item"><i class="legend-dot legend-occupied" aria-hidden="true"></i>On dine-in <strong>@Model.OccupiedTables</strong></span>
                </div>
                <form class="table-filters" method="get" action="/Staff/Tables" role="search">
                    <div class="system-search">
                        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                        <label class="visually-hidden" for="Search">Search table IDs</label>
                        <input asp-for="Search" type="search" placeholder="Search tables..." />
                        <button type="button" class="system-search-clear" aria-label="Clear search">
                            <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                        </button>
                        <button class="system-search-submit" type="submit">Search</button>
                    </div>
                    <input type="hidden" name="StatusFilter" value="@Model.StatusFilter" />
                </form>
            </div>
        </div>

        <nav class="area-filters" aria-label="Filter tables by availability">
            <a class="filter-button @(Model.StatusFilter == "All" ? "active" : "")" aria-pressed="@(Model.StatusFilter == "All")" href="/Staff/Tables?StatusFilter=All">All tables</a>
            <a class="filter-button @(Model.StatusFilter == "Available" ? "active" : "")" aria-pressed="@(Model.StatusFilter == "Available")" href="/Staff/Tables?StatusFilter=Available">Available</a>
            <a class="filter-button @(Model.StatusFilter == "Reserved" ? "active" : "")" aria-pressed="@(Model.StatusFilter == "Reserved")" href="/Staff/Tables?StatusFilter=Reserved">Reserved</a>
            <a class="filter-button @(Model.StatusFilter == "On dine-in" ? "active" : "")" aria-pressed="@(Model.StatusFilter == "On dine-in")" href="/Staff/Tables?StatusFilter=On%20dine-in">On dine-in</a>
        </nav>

        @if (Model.Tables.Count == 0)
        {
            <p class="no-tables">No tables match this filter.</p>
        }
        else
        {
            <section class="tables-grid" aria-label="Tables">
                @foreach (var table in Model.Tables)
                {
                <article class="table-card @TablesModel.StatusCssClass(table.Availability)">
                    <div class="table-card-heading">
                        <div>
                            <span class="table-card-label">Dining table</span>
                            <h2>@table.TableID</h2>
                        </div>
                        <span class="table-status">
                            <i class="table-status-dot" aria-hidden="true"></i>
                            @table.Availability
                        </span>
                    </div>

                    <div class="table-layout" role="img" aria-label="@table.TableID with @table.Capacity seats">
                        <div class="table-seating" style="--seat-radius: @(table.Capacity <= 4 ? 48 : table.Capacity <= 8 ? 56 : 64)px; --chair-size: @(table.Capacity > 24 ? 8 : table.Capacity > 12 ? 10 : 16)px;">
                            @for (var seatIndex = 0; seatIndex < table.Capacity; seatIndex++)
                            {
                                <span class="table-chair" style="--seat-angle: @(seatIndex * 360.0 / table.Capacity)deg;" aria-hidden="true"></span>
                            }
                            <div class="table-surface @(table.Capacity <= 4 ? "table-small" : table.Capacity <= 8 ? "table-medium" : "table-large")">
                                <i class="fa-solid fa-utensils" aria-hidden="true"></i>
                                <span>@table.TableID</span>
                            </div>
                        </div>
                    </div>

                    <div class="table-card-meta">
                        <span class="table-capacity">
                            <i class="fa-solid fa-user-group" aria-hidden="true"></i>
                            <strong>@table.Capacity</strong> seats
                        </span>
                        <span class="table-meta-caption">Guest capacity</span>
                    </div>

                    <details class="table-edit-details" open="@(Model.TableUpdate.TableID == table.TableID && !ViewData.ModelState.IsValid ? "open" : null)">
                        <summary>
                            <i class="fa-solid fa-sliders" aria-hidden="true"></i>
                            <span>Update table</span>
                            <i class="fa-solid fa-chevron-down edit-chevron" aria-hidden="true"></i>
                        </summary>
                        <form method="post" action="/Staff/Tables?handler=Update" class="table-edit-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="tableId" value="@table.TableID" />
                            <input type="hidden" name="StatusFilter" value="@Model.StatusFilter" />
                            <input type="hidden" name="Search" value="@Model.Search" />
                            <label class="table-edit-field">
                                <span>Capacity</span>
                                <input type="number" name="capacity" value="@table.Capacity" min="1" max="100" required />
                            </label>
                            <label class="table-edit-field">
                                <span>Status</span>
                                <select name="availability" class="table-status-select">
                                    @foreach (var status in Model.AvailabilityStatuses)
                                    {
                                        if (status.Equals(table.Availability, StringComparison.OrdinalIgnoreCase))
                                        {
                                            <option value="@status" selected>@status</option>
                                        }
                                        else
                                        {
                                            <option value="@status">@status</option>
                                        }
                                    }
                                </select>
                            </label>
                            <button type="submit" class="save-table-button">
                                <i class="fa-solid fa-check" aria-hidden="true"></i>
                                Save changes
                            </button>
                            @if (User.IsInRole("Administrator"))
                            {
                                <button type="button" class="row-delete save-table-button delete-table-button" data-table-id="@table.TableID">
                                        <i class="fas fa-trash-can" aria-hidden="true"></i>
                                    Remove Table
                                </button>
                            }
                            <span asp-validation-for="TableUpdate.Capacity" class="text-danger"></span>
                        </form>
                    </details>
                </article>
                }
            </section>
        }
    </section>
</section>

<dialog class="table-dialog" id="addTableModal" aria-labelledby="add-table-dialog-title">
    <form method="post" action="/Staff/Tables?handler=AddTable" class="table-dialog-form" id="addTableForm">
        @Html.AntiForgeryToken()
        <header class="table-dialog-header">
            <div>
                <p class="eyebrow">Dining room setup</p>
                <h2 id="add-table-dialog-title">Add table</h2>
            </div>
            <button type="button" class="table-dialog-close" data-close-table-modal aria-label="Close add table dialog">
                <i class="fa-solid fa-xmark" aria-hidden="true"></i>
            </button>
        </header>
        <label class="table-edit-field">
            <span>Table ID</span>
            <input type="text" name="tableId" maxlength="20" required placeholder="e.g. T-21" />
        </label>
        <label class="table-edit-field">
            <span>Capacity</span>
            <input type="number" name="capacity" min="1" max="100" required />
        </label>
        <label class="table-edit-field">
            <span>Status</span>
            <select name="availability" required>
                @foreach (var status in Model.AvailabilityStatuses)
                {
                    <option value="@status">@status</option>
                }
            </select>
        </label>
        <div class="table-dialog-actions">
            <button type="button" class="table-dialog-cancel" data-close-table-modal>Cancel</button>
            <button type="submit" class="save-table-button">
                <i class="fa-solid fa-plus" aria-hidden="true"></i>
                Add table
            </button>
        </div>
    </form>
</dialog>

<dialog class="table-dialog" id="deleteTableModal" aria-labelledby="delete-table-dialog-title">
    <form method="post" action="/Staff/Tables?handler=Delete" class="table-dialog-form" id="deleteTableForm">
        @Html.AntiForgeryToken()
        <header class="table-dialog-header">
            <div>
                <p class="eyebrow">Dining room setup</p>
                <h2 id="delete-table-dialog-title">Remove table?</h2>
            </div>
            <button type="button" class="table-dialog-close" data-close-table-modal aria-label="Close delete table dialog">
                <i class="fa-solid fa-xmark" aria-hidden="true"></i>
            </button>
        </header>
        <input type="hidden" name="TableID" id="DeleteTableID"/>
        <div class="table-dialog-actions">
            <button type="button" class="table-dialog-cancel" data-close-table-modal>Cancel</button>
            <button type="submit" class="save-table-button">
                <i class="fas fa-trash-can" aria-hidden="true"></i>
                Remove table
            </button>
        </div>
    </form>
</dialog>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/tables_management.js" asp-append-version="true"></script>
    <script>
        document.getElementById("tableSearchReset")?.addEventListener("click", () => {
            const input = document.querySelector(".search-bar input[name='Search']");
            if (input) {
                input.value = "";
                input.focus();
            }
        });

        const deleteTableModal = document.getElementById("deleteTableModal");
        const deleteTableID = document.getElementById("DeleteTableID");

        document.querySelectorAll(".row-delete").forEach(button =>{
            button.addEventListener("click", function(){
                const tableID = this.dataset.tableId;
                deleteTableID.value = tableID;
                deleteTableModal.showModal();
            })
        })

        deleteTableModal.querySelectorAll("[data-close-table-modal]").forEach(button => {
            button.addEventListener("click", function(){
                deleteTableModal.close();
            });
        });
    </script>
}
