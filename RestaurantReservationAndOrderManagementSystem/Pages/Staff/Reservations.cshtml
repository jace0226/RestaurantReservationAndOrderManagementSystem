@page "/Staff/Reservations"
@model RestaurantReservationAndOrderManagementSystem.Pages.ReservationsModel
@{
    ViewData["Title"] = "Reservations";
}

<link rel="stylesheet" href="~/css/reservations_page.css" asp-append-version="true" />

<section class="reservations-page" aria-label="Reservation management">
    <header class="reservation-hero">
        <div>
            <p class="eyebrow">The reservation book</p>
            <h1>Who's joining us?</h1>
            <p class="hero-caption">Keep the room feeling easy, one booking at a time.</p>
        </div>
        <button class="new-reservation-button" type="button" id="openReservationDialog">
            <i class="fa-solid fa-plus" aria-hidden="true"></i>
            New reservation
        </button>
    </header>

    <section class="reservation-stats" aria-label="Reservation summary">
        <article class="summary-card">
            <i class="fa-regular fa-calendar-days" aria-hidden="true"></i>
            <div><strong>@Model.BookingsToday</strong><span>bookings today</span></div>
        </article>
        <article class="summary-card">
            <i class="fa-solid fa-user-group" aria-hidden="true"></i>
            <div><strong>@Model.GuestsToday</strong><span>guests expected today</span></div>
        </article>
        <article class="summary-card">
            <i class="fa-solid fa-table-cells" aria-hidden="true"></i>
            <div><strong>@Model.AvailableTables</strong><span>tables available</span></div>
        </article>
    </section>

    <form class="reservation-filters" method="get" asp-page="/Staff/Reservations" role="search">
        <label class="search-control">
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
            <span class="visually-hidden">Search guests or tables</span>
            <input asp-for="Search" type="search" placeholder="Search guests or tables..." />
        </label>
        <div class="date-control">
            <i class="fa-regular fa-calendar-days" aria-hidden="true"></i>
            <label for="selectedDate" class="visually-hidden">Select date</label>
            <input type="date"
                   id="selectedDate"
                   name="selectedDate"
                   value="@Model.SelectedDate?.ToString("yyyy-MM-dd")" />
        </div>
        <button class="filter-submit" type="submit">Filter</button>
    </form>

    <section class="reservation-list-panel" aria-labelledby="reservation-list-title">
        <div class="list-heading">
            <div>
                <p class="eyebrow">Reservation schedule</p>
                <h2 id="reservation-list-title">Reservation List (@Model.SelectedDate?.ToString("dd/MM/yyyy"))</h2>
            </div>
            <span class="booking-count">@Model.Reservations.Count booking@(Model.Reservations.Count == 1 ? "" : "s")</span>
        </div>
        @if (TempData["ReservationStatusMessage"] is string statusMessage)
        {
            <p class="reservation-feedback" role="status">@statusMessage</p>
        }
        @if (TempData["ReservationStatusError"] is string statusError)
        {
            <p class="reservation-feedback reservation-feedback-error" role="alert">@statusError</p>
        }
        @if (TempData["ReservationTableMessage"] is string tableMessage)
        {
            <p class="reservation-feedback" role="status">@tableMessage</p>
        }
        @if (TempData["ReservationTableError"] is string tableError)
        {
            <p class="reservation-feedback reservation-feedback-error" role="alert">@tableError</p>
        }

        <div class="reservation-table-wrap">
            <table class="reservation-table" aria-label="Reservations">
                <thead>
                    <tr>
                        <th scope="col">Time and date</th>
                        <th scope="col">Guest</th>
                        <th scope="col">Guests</th>
                        <th scope="col">Table</th>
                        <th scope="col">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Reservations.Count == 0)
                    {
                        <tr>
                            <td class="empty-reservations" colspan="5">No reservations match this date and search.</td>
                        </tr>
                    }
                    @foreach (var reservation in Model.Reservations)
                    {
                        <tr>
                            <td class="time-cell">
                                <span class="time-info">
                                    <strong>@reservation.BookingTime.ToString("h:mm tt")</strong>
                                    <span>@reservation.BookingDate.ToString("MMM d, yyyy")</span>
                                </span>
                            </td>
                            <td class="guest-cell">
                                <span class="guest-profile">
                                    <span class="guest-avatar">@GetInitials(reservation.GuestName)</span>
                                    <span class="guest-info">
                                        <strong>@reservation.GuestName</strong>
                                        <small>@reservation.GuestPhone</small>
                                    </span>
                                </span>
                            </td>
                            <td data-label="Guests">@reservation.PartySize @(reservation.PartySize == 1 ? "guest" : "guests")</td>
                            <td data-label="Table">
                                <form method="post" asp-page-handler="ReassignTable" class="table-reassign-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="bookingId" value="@reservation.BookingID" />
                                    <input type="hidden" name="selectedDate" value="@Model.SelectedDate?.ToString("yyyy-MM-dd")" />
                                    <input type="hidden" name="Search" value="@Model.Search" />
                                    <label class="visually-hidden" for="table-@reservation.BookingID">Table for @reservation.GuestName</label>
                                    <select id="table-@reservation.BookingID" name="tableId" required>
                                        @if (string.IsNullOrEmpty(reservation.TableID))
                                        {
                                            <option value="" selected>Select a table</option>
                                        }
                                        @foreach (var table in Model.Tables)
                                        {
                                            var isCurrentTable = table.TableID == reservation.TableID;
                                            var canSeatParty = table.Capacity >= reservation.PartySize;
                                            var isAvailable = table.Availability.Equals("Available", StringComparison.OrdinalIgnoreCase);
                                            <option value="@table.TableID"
                                                    selected="@(isCurrentTable ? "selected" : null)"
                                                    disabled="@(!isCurrentTable && (!canSeatParty || !isAvailable))">
                                                @table.TableID · @table.Capacity seats
                                                @if (!isAvailable)
                                                {
                                                    @: (@table.Availability)
                                                }
                                                else if (!canSeatParty)
                                                {
                                                    @: (too small)
                                                }
                                            </option>
                                        }
                                    </select>
                                    <button class="save-status-button" type="submit">Save table</button>
                                </form>
                            </td>
                            <td>
                                <form method="post" asp-page-handler="UpdateStatus" class="status-edit-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="bookingId" value="@reservation.BookingID" />
                                    <input type="hidden" name="selectedDate" value="@Model.SelectedDate?.ToString("yyyy-MM-dd")" />
                                    <input type="hidden" name="Search" value="@Model.Search" />
                                    <label class="visually-hidden" for="status-@reservation.BookingID">Status for @reservation.GuestName</label>
                                    <select id="status-@reservation.BookingID"
                                            name="newStatus"
                                            class="status-select @ReservationsModel.StatusCssClass(reservation.Status)">
                                        @foreach (var status in Model.Statuses)
                                        {
                                            if (status == reservation.Status)
                                            {
                                                <option value="@status" selected>@status</option>
                                            }
                                            else
                                            {
                                                <option value="@status">@status</option>
                                            }
                                        }
                                    </select>
                                    @if (reservation.Status is "Pending" or "Waiting")
                                    {
                                        <label class="visually-hidden" for="confirm-table-@reservation.BookingID">
                                            Table for confirming @reservation.GuestName
                                        </label>
                                        <select id="confirm-table-@reservation.BookingID"
                                                class="confirm-table-select"
                                                name="tableId"
                                                aria-label="Select an available table to confirm this reservation"
                                                hidden>
                                            <option value="">Select available table</option>
                                            @foreach (var table in Model.Tables)
                                            {
                                                var canSeatParty = table.Capacity >= reservation.PartySize;
                                                var isAvailable = table.Availability.Equals("Available", StringComparison.OrdinalIgnoreCase);
                                                if (canSeatParty && isAvailable)
                                                {
                                                    <option value="@table.TableID">@table.TableID · @table.Capacity seats</option>
                                                }
                                            }
                                        </select>
                                    }
                                    <button class="save-status-button" type="submit">Save</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</section>

<dialog class="reservation-dialog" id="reservationDialog" aria-labelledby="reservation-dialog-title">
    <form method="post" asp-page-handler="Create" class="reservation-dialog-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="selectedDate" value="@Model.SelectedDate?.ToString("yyyy-MM-dd")" />
        <input type="hidden" name="Search" value="@Model.Search" />
        <header class="dialog-heading">
            <div>
                <p class="eyebrow">Add to the book</p>
                <h2 id="reservation-dialog-title">New reservation</h2>
            </div>
            <button type="button" class="dialog-close" id="closeReservationDialog" aria-label="Close">&times;</button>
        </header>
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>

        <div class="dialog-field-row">
            <label class="dialog-field">
                <span>Date</span>
                <input asp-for="NewReservation.BookingDate" type="date" />
                <span asp-validation-for="NewReservation.BookingDate" class="text-danger"></span>
            </label>
            <label class="dialog-field">
                <span>Time</span>
                <input asp-for="NewReservation.BookingTime" type="time" />
                <span asp-validation-for="NewReservation.BookingTime" class="text-danger"></span>
            </label>
        </div>

        <div class="dialog-field-row">
            <label class="dialog-field">
                <span>Party size</span>
                <input asp-for="NewReservation.PartySize" type="number" min="1" max="100" />
                <span asp-validation-for="NewReservation.PartySize" class="text-danger"></span>
            </label>
            <label class="dialog-field">
                <span>Table</span>
                <select asp-for="NewReservation.TableID">
                    <option value="">Select a table</option>
                    @foreach (var table in Model.Tables)
                    {
                        <option value="@table.TableID">@table.TableID · @table.Capacity seats (@table.Availability)</option>
                    }
                </select>
                <span asp-validation-for="NewReservation.TableID" class="text-danger"></span>
            </label>
        </div>

        <label class="dialog-field">
            <span>Notes <small>(optional)</small></span>
            <textarea asp-for="NewReservation.BookingNotes" rows="3" maxlength="500"></textarea>
            <span asp-validation-for="NewReservation.BookingNotes" class="text-danger"></span>
        </label>

        <footer class="dialog-actions">
            <button type="button" class="dialog-cancel" id="cancelReservationDialog">Cancel</button>
            <button type="submit" class="dialog-submit">Create reservation</button>
        </footer>
    </form>
</dialog>

@functions {
    private static string GetInitials(string fullName)
    {
        return string.Join("", fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(part => char.ToUpperInvariant(part[0])));
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const reservationDialog = document.getElementById("reservationDialog");
        document.getElementById("openReservationDialog").addEventListener("click", () => reservationDialog.showModal());
        document.getElementById("closeReservationDialog").addEventListener("click", () => reservationDialog.close());
        document.getElementById("cancelReservationDialog").addEventListener("click", () => reservationDialog.close());
        document.querySelector(".reservation-dialog-form").addEventListener("submit", event => {
            if (!event.currentTarget.checkValidity()) return;

            const submitButton = event.currentTarget.querySelector(".dialog-submit");
            submitButton.disabled = true;
            submitButton.textContent = "Creating reservation...";
        });
        reservationDialog.addEventListener("click", event => {
            if (event.target === reservationDialog) reservationDialog.close();
        });
        if (@Model.ShowCreateModal.ToString().ToLowerInvariant()) reservationDialog.showModal();

        document.querySelectorAll(".status-select").forEach(select => {
            const tableSelect = select.form.querySelector(".confirm-table-select");
            const updateConfirmationTable = () => {
                if (!tableSelect) return;

                const requiresTable = select.value === "Confirmed";
                tableSelect.hidden = !requiresTable;
                tableSelect.required = requiresTable;
            };
            select.addEventListener("change", updateConfirmationTable);
            updateConfirmationTable();

            select.addEventListener("change", () => {
                select.className = `status-select ${{
                    "Pending": "status-pending",
                    "Waiting": "status-waiting",
                    "Confirmed": "status-confirmed",
                    "Arriving": "status-arriving",
                    "On dine-in": "status-dining",
                    "Completed": "status-completed",
                    "Cancelled": "status-cancelled"
                }[select.value] ?? "status-waiting"}`;
            });
        });
    </script>
}
