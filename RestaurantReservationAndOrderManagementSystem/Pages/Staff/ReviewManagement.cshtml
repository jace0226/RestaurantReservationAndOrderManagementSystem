@page "/Admin/ReviewManagement"
@model RestaurantReservationAndOrderManagementSystem.Pages.Staff.ReviewManagementModel
@{
}

<link rel="stylesheet" href="~/css/reviewmanagement_page.css" asp-append-version="true" />

<sectiom class="reviewmanagement-page">
    <div class="header">
        <div>
            <p class="eyebrow">REVIEW MANAGEMENT</p>
            <h1>Manage Your Reviews</h1>
            <p class="header-caption">View and manage customer reviews for your restaurant.</p>
        </div>
    </div>

    <div class="summary-container">

        <div class="summary-card">
            <div class="summary-card-icon">
                <i class="fa-solid fa-star"></i>
            </div>
            <div class="summary-card-text">
                <p>Average Rating</p>
                <strong>@Model.AverageRating.ToString("0.0") / 5</strong>
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-card-icon">
                <i class="fa-solid fa-comments"></i>
            </div>
            <div class="summary-card-text">
                <p>Total Reviews</p>
                <strong>@Model.TotalReviews</strong>
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-card-icon">
                <i class="fa-solid fa-thumbs-up"></i>
            </div>
            <div class="summary-card-text">
                <p>Positive Reviews</p>
                <strong>@Model.PositiveReviews</strong>
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-card-icon">
                <i class="fa-solid fa-thumbs-down"></i>
            </div>
            <div class="summary-card-text">
                <p>Negative Reviews</p>
                <strong>@Model.NegativeReviews</strong>
            </div>
        </div>

    </div>


    <div>
        <form method="get" id="searchForm" role="search">
            <div class="filter-container">
                <div class="system-search">
                    <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                    <label class="visually-hidden" for="reviewManagementSearch">Search reviews</label>
                    <input id="reviewManagementSearch"
                           type="search"
                           name="SearchTerm"
                           value="@Model.SearchTerm"
                           placeholder="Search by customer name, food item or comment..." />
                    <button type="button" class="system-search-clear" aria-label="Clear search">
                        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                    </button>
                    <button type="submit" class="system-search-submit">Search</button>
                </div>

                <div class="user-filter" id="userFilter">
                    <i class="fas fa-filter"></i>

                    <select id="ratingFilter" name="FilterRating">
                        <option value="" selected="@(string.IsNullOrEmpty(Model.FilterRating))">
                            All Ratings
                        </option>

                        <option value="5" selected="@(Model.FilterRating == "5")">5 stars</option>
                        <option value="4" selected="@(Model.FilterRating == "4")">4 stars</option>
                        <option value="3" selected="@(Model.FilterRating == "3")">3 stars</option>
                        <option value="2" selected="@(Model.FilterRating == "2")">2 stars</option>
                        <option value="1" selected="@(Model.FilterRating == "1")">1 star</option>
                    </select>
                    <i class="fas fa-chevron-down dropdown-arrow" id="dropdownArrow"></i>
                </div>

                <div class="reset-filter" id="resetFilter" title="Reset filters">
                    <i class="fas fa-rotate-left"></i>
                </div>
            </div>
        </form>
    </div>


    <div class="review-section">
        <table class="user-table">
            <thead>
                <tr>
                    <th>Customer</th>
                    <th>Rating</th>
                    <th>Review</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var review in Model.Reviews)
                {
                <tr>
                    <td>@review.FullName</td>
                    <td>
                        @review.Stars
                            <span class="star">★</span>
                    </td>
                    <td class="review-message">@review.Message</td>
                </tr>    
                }
            </tbody>
        </table>
    </div>
</sectiom>

@section Scripts {
    <script>
        const searchForm = document.getElementById("searchForm");
        const ratingFilter = document.getElementById("ratingFilter");
        const userFilter = document.getElementById("userFilter");

        // Dropdown animation
        ratingFilter.addEventListener("mousedown", () => {
            userFilter.classList.add("is-open");
        });

        // Automatically submit when rating changes
        ratingFilter.addEventListener("change", () => {
            userFilter.classList.remove("is-open");
            searchForm.submit();
        });

        // Close dropdown animation
        ratingFilter.addEventListener("blur", () => {
            userFilter.classList.remove("is-open");
        });

        ratingFilter.addEventListener("keydown", (event) => {
            if (event.key === "Escape" || event.key === "Tab") {
                userFilter.classList.remove("is-open");
            }
        });

        // Reset search and rating filter
        document.getElementById("resetFilter").addEventListener("click", function() {
            const searchBar = searchForm.querySelector('input[name="SearchTerm"]');

            if (searchBar) {
                searchBar.value = "";
            }

            ratingFilter.selectedIndex = 0;

            searchForm.submit();
        });

        document.getElementById("resetFilter").addEventListener("click", function() {
            const form = document.getElementById("search");

            const searchBar = form.querySelector('input[name="SearchTerm"]');
            if (searchBar) {
                searchBar.value = "";
            }

            form.querySelectorAll("select").forEach(select => {
                select.selectedIndex = 0;
            });

            form.submit();
        })
    </script>
}
