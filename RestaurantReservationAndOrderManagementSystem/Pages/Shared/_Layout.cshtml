<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RestaurantReservationAndOrderManagementSystem</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RestaurantReservationAndOrderManagementSystem.styles.css" asp-append-version="true" />
</head>
<body>

    @{
        var currentPath = Context.Request.Path;
    }

    <div class="app-wrapper">
        <!-- LEFT SIDEBAR NAVIGATION -->
        <aside class="sidebar" role="navigation" aria-label="Main Navigation">
            <h4 class="brand">
                Between<br/>Bites
            </h4>

            <nav class="nav-menu" aria-label="Sidebar Menu">
                <a class="nav-item @(currentPath.StartsWithSegments("/Staff/Dashboard", StringComparison.OrdinalIgnoreCase) ? "active" : null)" href="/Staff/Dashboard" aria-current="@(currentPath.StartsWithSegments("/Staff/Dashboard", StringComparison.OrdinalIgnoreCase) ? "page" : null)">
                    <i class="fa-solid fa-house"></i>
                    <span>Dashboard</span>
                </a>
                @if (User.IsInRole("Administrator")){
                    <a class="nav-item @(currentPath.StartsWithSegments("/Admin/Reports", StringComparison.OrdinalIgnoreCase) ? "active" : null)" href="/Admin/Reports" aria-current="@(currentPath.StartsWithSegments("/Admin/Reports", StringComparison.OrdinalIgnoreCase) ? "page" : null)">
                        <i class="fa-solid fa-chart-column"></i>
                        <span>Reports</span>
                    </a>
                    <a class="nav-item @(currentPath.StartsWithSegments("/Admin/ReviewManagement", StringComparison.OrdinalIgnoreCase) ? "active" : null)" href="/Admin/ReviewManagement" aria-current="@(currentPath.StartsWithSegments("/Admin/ReviewManagement", StringComparison.OrdinalIgnoreCase) ? "page" : null)">
                        <i class="fa-solid fa-star"></i>
                        <span>Review Management</span>
                    </a>
                    <a class="nav-item @(currentPath.StartsWithSegments("/Admin/StaffManagement", StringComparison.OrdinalIgnoreCase) ? "active" : null)" href="/Admin/StaffManagement" aria-current="@(currentPath.StartsWithSegments("/Admin/StaffManagement", StringComparison.OrdinalIgnoreCase) ? "page" : null)">
                        <i class="fa-solid fa-users"></i>
                        <span>Staff Management</span>
                    </a>
                    <a class="nav-item @(currentPath.StartsWithSegments("/Admin/CustomerManagement", StringComparison.OrdinalIgnoreCase) ? "active" : null)" href="/Admin/CustomerManagement" aria-current="@(currentPath.StartsWithSegments("/Admin/CustomerManagement", StringComparison.OrdinalIgnoreCase) ? "page" : null)">
                        <i class="fa-solid fa-user-group"></i>
                        <span>Customer Management</span>
                    </a>
                }
                <a class="nav-item @(currentPath.StartsWithSegments("/Staff/Menus", StringComparison.OrdinalIgnoreCase) ? "active" : null)" href="/Staff/Menus" aria-current="@(currentPath.StartsWithSegments("/Staff/Menus", StringComparison.OrdinalIgnoreCase) ? "page" : null)">
                    <i class="fa-solid fa-burger"></i>
                    <span>Menus</span>
                </a>
                <a class="nav-item @(currentPath.StartsWithSegments("/Staff/Orders", StringComparison.OrdinalIgnoreCase) ? "active" : null)" href="/Staff/Orders" aria-current="@(currentPath.StartsWithSegments("/Staff/Orders", StringComparison.OrdinalIgnoreCase) ? "page" : null)">
                    <i class="fa-solid fa-utensils"></i>
                    <span>Orders</span>
                </a>
                <a class="nav-item @(currentPath.StartsWithSegments("/Staff/Reservations", StringComparison.OrdinalIgnoreCase) ? "active" : null)" href="/Staff/Reservations" aria-current="@(currentPath.StartsWithSegments("/Staff/Reservations", StringComparison.OrdinalIgnoreCase) ? "page" : null)">
                    <i class='fas fa-calendar-check'></i>
                    <span>Reservation</span>
                </a>
                <a class="nav-item @(currentPath.StartsWithSegments("/Staff/Tables", StringComparison.OrdinalIgnoreCase) ? "active" : null)" href="/Staff/Tables" aria-current="@(currentPath.StartsWithSegments("/Staff/Tables", StringComparison.OrdinalIgnoreCase) ? "page" : null)">
                    <i class='fas fa-chair'></i>
                    <span>Tables</span>
                </a>
            </nav>

            <div class="sidebar-footer">
                <form method="post" action="/Authenticate?handler=Logout">
                    @Html.AntiForgeryToken()
                    <button class="nav-item logout-btn" type="submit">
                        <i class="fa-solid fa-right-from-bracket"></i>
                        <span>Logout</span>
                    </button>
                </form>
            </div>
        </aside>

        <!-- MAIN AREA (Top header + Content) -->
        <div class="main-area">
            <header class="top-header">
                <div class="page-title">@ViewData["Title"]</div>
                <div class="header-right">
                    <button class="notification-btn" aria-label="Notifications">
                        <i class="fa-solid fa-bell"></i>
                    </button>
                    <div class="user-profile" aria-label="User Profile">
                        <div class="avatar" aria-hidden>JL</div>
                        <div class="user-meta">
                            <div class="user-name">Joshua Lee</div>
                            <div class="user-role">Staff</div>
                        </div>
                    </div>
                </div>
            </header>

            <main role="main" class="content-body">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://kit.fontawesome.com/f3ce044c74.js" crossorigin="anonymous"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
