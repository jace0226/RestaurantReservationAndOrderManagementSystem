@page "/Tables"
@model RestaurantReservationAndOrderManagementSystem.Pages.TablesModel
@{
}

<link rel="stylesheet" href="~/css/tables_page.css" />

<section class="tables-page">
  <header class="tables-header">
	<div>
	  <h2>Manage Tables</h2>
	</div>

	<div style="display:flex; flex-direction:column; align-items:flex-end; gap:0.6rem;">
	  <div class="filters" role="tablist" aria-label="Dining area filters">
		<button class="filter-btn active" role="tab">Main Dining</button>
		<button class="filter-btn" role="tab">Terrace</button>
		<button class="filter-btn" role="tab">Outdoor</button>
	  </div>

	  <div class="status-legend" aria-hidden="true">
		<div class="legend-item"><span class="legend-dot" style="background:#2aa55a;"></span><span>Available</span></div>
		<div class="legend-item"><span class="legend-dot" style="background:#f39c9c;"></span><span>Reserved</span></div>
		<div class="legend-item"><span class="legend-dot" style="background:#f2b84b;"></span><span>On Dine</span></div>
	  </div>
	</div>
  </header>

  <div class="tables-grid" role="list">
	<!-- Sample table cards (mix of sizes and statuses) -->
	<article class="table-card status-available large" role="listitem">
	  <div class="table-id">Table #1</div>
	  <div class="table-capacity"><span class="person-icon">👥</span><span>8</span></div>
	</article>

	<article class="table-card status-reserved" role="listitem">
	  <div class="table-id">Table #2</div>
	  <div class="table-capacity"><span class="person-icon">👥</span><span>2</span></div>
	</article>

	<article class="table-card status-available" role="listitem">
	  <div class="table-id">Table #3</div>
	  <div class="table-capacity"><span class="person-icon">👥</span><span>2</span></div>
	</article>

	<article class="table-card status-ondine" role="listitem">
	  <div class="table-id">Table #4</div>
	  <div class="table-capacity"><span class="person-icon">👥</span><span>3</span></div>
	</article>

	<article class="table-card status-available" role="listitem">
	  <div class="table-id">Table #5</div>
	  <div class="table-capacity"><span class="person-icon">👥</span><span>6</span></div>
	</article>

	<article class="table-card status-reserved large" role="listitem">
	  <div class="table-id">Table #6</div>
	  <div class="table-capacity"><span class="person-icon">👥</span><span>7</span></div>
	</article>

	<article class="table-card status-available" role="listitem">
	  <div class="table-id">Table #7</div>
	  <div class="table-capacity"><span class="person-icon">👥</span><span>10</span></div>
	</article>

	<article class="table-card status-ondine" role="listitem">
	  <div class="table-id">Table #8</div>
	  <div class="table-capacity"><span class="person-icon">👥</span><span>2</span></div>
	</article>

	<article class="table-card status-reserved" role="listitem">
	  <div class="table-id">Table #9</div>
	  <div class="table-capacity"><span class="person-icon">👥</span><span>4</span></div>
	</article>

	<article class="table-card status-available large" role="listitem">
	  <div class="table-id">Table #10</div>
	  <div class="table-capacity"><span class="person-icon">👥</span><span>8</span></div>
	</article>

	<article class="table-card status-available" role="listitem">
	  <div class="table-id">Table #11</div>
	  <div class="table-capacity"><span class="person-icon">👥</span><span>2</span></div>
	</article>

	<article class="table-card status-ondine" role="listitem">
	  <div class="table-id">Table #12</div>
	  <div class="table-capacity"><span class="person-icon">👥</span><span>8</span></div>
	</article>
  </div>
</section>
