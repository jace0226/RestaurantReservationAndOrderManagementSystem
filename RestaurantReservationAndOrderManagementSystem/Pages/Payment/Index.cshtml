@page "/Payment/Index"
@model RestaurantReservationAndOrderManagementSystem.Pages.Payment.IndexModel
@{
    ViewData["Title"] = "Payment Successful";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/payment-success.css" asp-append-version="true" />
</head>
<body class="payment-success-page">
    <main class="payment-success-main">
        <article class="receipt-card" aria-labelledby="payment-success-title">
            <a class="receipt-close" href="/Customer/Orders?Category=History" aria-label="Close and return to the main menu">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="m6 6 12 12M18 6 6 18" />
                </svg>
            </a>

            <header class="receipt-header">
                <svg class="success-receipt-icon" viewBox="0 0 72 72" role="img" aria-labelledby="receipt-icon-title">
                    <title id="receipt-icon-title">Receipt with a success checkmark</title>
                    <path class="receipt-icon-back" d="M29 9h29v43l-4-3-4 3-4-3-4 3-4-3-4 3-4-3-5 3z" />
                    <path class="receipt-icon-front" d="M14 20h34v43l-4-3-4 3-4-3-4 3-4-3-4 3-4-3-6 3z" />
                    <circle class="receipt-icon-check-bg" cx="31" cy="36" r="10" />
                    <path class="receipt-icon-check" d="m26.5 36 3.1 3.1 6-6.4" />
                    <path class="receipt-icon-line" d="M22 51h18" />
                </svg>
                <h1 id="payment-success-title">Payment Successful</h1>
            </header>

            <section class="receipt-section" aria-labelledby="payment-details-title">
                <h2 id="payment-details-title">Payment Details</h2>
                <dl class="receipt-details">
                    <div class="receipt-row">
                        <dt>Invoice Number</dt>
                        <dd>@Model.InvoiceNumber</dd>
                    </div>
                    <div class="receipt-row">
                        <dt>Order Time</dt>
                        <dd>@Model.Order.OrderDateTime.ToString("hh:mm tt, dd MMMM, yyyy")</dd>
                    </div>
                    <div class="receipt-row">
                        <dt>Payment Method</dt>
                        <dd>@Model.Payment.PaymentMethod</dd>
                    </div>
                    <div class="receipt-row">
                        <dt>Transaction Reference</dt>
                        <dd>@Model.Payment.TransactionReference</dd>
                    </div>
                    <div class="receipt-row">
                        <dt>Payment Status</dt>
                        <dd><span class="status-badge">Successful</span></dd>
                    </div>
                    <div class="receipt-row">
                        <dt>Amount</dt>
                        <dd>RM @Model.Payment.Amount.ToString("N2")</dd>
                    </div>
                    @if (Model.Payment.TenderedAmount.HasValue)
                    {
                        <div class="receipt-row">
                            <dt>Amount Tendered</dt>
                            <dd>RM @Model.Payment.TenderedAmount.Value.ToString("N2")</dd>
                        </div>
                        <div class="receipt-row">
                            <dt>Change Given</dt>
                            <dd>RM @Model.Payment.ChangeGiven.Value.ToString("N2")</dd>
                        </div>
                    }
                </dl>
            </section>

            <section class="receipt-section cost-section" aria-label="Cost breakdown">
                <dl class="receipt-details">
                    @foreach (var item in Model.Items)
                    {
                        <div class="receipt-row receipt-item-row">
                            <dt>
                                <div class="receipt-item-title">
                                    <span>@item.Name × @item.Quantity</span>
                                    @if (item.HasPromotion)
                                    {
                                        <span class="receipt-promo-tag">PROMO</span>
                                    }
                                </div>
                                @if (item.HasPromotion)
                                {
                                    <div class="receipt-item-subtext">
                                        <span class="receipt-del">RM @item.OriginalUnitPrice.ToString("N2")</span>
                                        <span class="receipt-deal">RM @item.EffectiveUnitPrice.ToString("N2") each</span>
                                    </div>
                                }
                            </dt>
                            <dd class="receipt-item-price">
                                @if (item.HasPromotion)
                                {
                                    <span class="receipt-line-discount">-RM @item.LineDiscount.ToString("N2")</span>
                                }
                                <span class="receipt-line-total">RM @item.LineTotal.ToString("N2")</span>
                            </dd>
                        </div>
                    }

                    @if (Model.HasPromotionDiscount)
                    {
                        <div class="receipt-row">
                            <dt>Original Subtotal</dt>
                            <dd>RM @Model.OriginalSubtotal.ToString("N2")</dd>
                        </div>
                        <div class="receipt-row receipt-discount-row">
                            <dt>Promotion Discount</dt>
                            <dd>- RM @Model.TotalDiscount.ToString("N2")</dd>
                        </div>
                        <div class="receipt-row">
                            <dt>Subtotal (After Promo)</dt>
                            <dd>RM @Model.Subtotal.ToString("N2")</dd>
                        </div>
                    }
                    else
                    {
                        <div class="receipt-row">
                            <dt>Subtotal</dt>
                            <dd>RM @Model.Subtotal.ToString("N2")</dd>
                        </div>
                    }

                    <div class="receipt-row">
                        <dt>Tax (10%)</dt>
                        <dd>RM @Model.Tax.ToString("N2")</dd>
                    </div>
                    <div class="receipt-row total-row">
                        <dt>Total Amount</dt>
                        <dd>RM @Model.Total.ToString("N2")</dd>
                    </div>
                </dl>

                @if (Model.HasPromotionDiscount)
                {
                    <div class="receipt-savings-callout" role="note">
                        <svg viewBox="0 0 24 24" aria-hidden="true" class="savings-callout-icon">
                            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                        </svg>
                        <span>You saved <strong>RM @Model.TotalDiscount.ToString("N2")</strong> on this order!</span>
                    </div>
                }
            </section>

            <div class="receipt-actions">
                <button class="receipt-view-button" type="button" id="open-receipt">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M2 12s3.6-6 10-6 10 6 10 6-3.6 6-10 6S2 12 2 12Z" />
                        <circle cx="12" cy="12" r="2.5" />
                    </svg>
                    <span>View PDF Receipt</span>
                </button>
            </div>
            <span class="receipt-tear" aria-hidden="true"></span>
        </article>
    </main>

    <dialog class="receipt-dialog" id="receipt-dialog" aria-labelledby="print-receipt-title">
        <div class="print-receipt">
            <form method="dialog" class="dialog-close-form">
                <button class="receipt-close dialog-close" type="submit" aria-label="Close receipt preview">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="m6 6 12 12M18 6 6 18" />
                    </svg>
                </button>
            </form>
            <header class="print-receipt-header">
                <p class="print-receipt-brand">BETWEEN BITES</p>
                <h2 id="print-receipt-title">Payment Receipt</h2>
                <p>Invoice @Model.InvoiceNumber</p>
            </header>
            <dl class="receipt-details print-receipt-details">
                <div class="receipt-row">
                    <dt>Order Time</dt>
                    <dd>@Model.Order.OrderDateTime.ToString("hh:mm tt, dd MMMM, yyyy")</dd>
                </div>
                <div class="receipt-row">
                    <dt>Payment Method</dt>
                    <dd>@Model.Payment.PaymentMethod</dd>
                </div>
                <div class="receipt-row">
                    <dt>Transaction Reference</dt>
                    <dd>@Model.Payment.TransactionReference</dd>
                </div>
                <div class="receipt-row">
                    <dt>Payment Status</dt>
                    <dd>Successful</dd>
                </div>
                <div class="receipt-row">
                    <dt>Amount</dt>
                    <dd>RM @Model.Payment.Amount.ToString("N2")</dd>
                </div>
                @if (Model.Payment.TenderedAmount.HasValue)
                {
                    <div class="receipt-row">
                        <dt>Amount Tendered</dt>
                        <dd>RM @Model.Payment.TenderedAmount.Value.ToString("N2")</dd>
                    </div>
                    <div class="receipt-row">
                        <dt>Change Given</dt>
                        <dd>RM @Model.Payment.ChangeGiven.Value.ToString("N2")</dd>
                    </div>
                }

                @foreach (var item in Model.Items)
                {
                    <div class="receipt-row receipt-item-row">
                        <dt>
                            <div class="receipt-item-title">
                                <span>@item.Name × @item.Quantity</span>
                                @if (item.HasPromotion)
                                {
                                    <span class="receipt-promo-tag">PROMO</span>
                                }
                            </div>
                            @if (item.HasPromotion)
                            {
                                <div class="receipt-item-subtext">
                                    <span class="receipt-del">RM @item.OriginalUnitPrice.ToString("N2")</span>
                                    <span class="receipt-deal">RM @item.EffectiveUnitPrice.ToString("N2") each</span>
                                </div>
                            }
                        </dt>
                        <dd class="receipt-item-price">
                            @if (item.HasPromotion)
                            {
                                <span class="receipt-line-discount">-RM @item.LineDiscount.ToString("N2")</span>
                            }
                            <span class="receipt-line-total">RM @item.LineTotal.ToString("N2")</span>
                        </dd>
                    </div>
                }

                @if (Model.HasPromotionDiscount)
                {
                    <div class="receipt-row">
                        <dt>Original Subtotal</dt>
                        <dd>RM @Model.OriginalSubtotal.ToString("N2")</dd>
                    </div>
                    <div class="receipt-row receipt-discount-row">
                        <dt>Promotion Discount</dt>
                        <dd>- RM @Model.TotalDiscount.ToString("N2")</dd>
                    </div>
                    <div class="receipt-row">
                        <dt>Subtotal (After Promo)</dt>
                        <dd>RM @Model.Subtotal.ToString("N2")</dd>
                    </div>
                }
                else
                {
                    <div class="receipt-row">
                        <dt>Subtotal</dt>
                        <dd>RM @Model.Subtotal.ToString("N2")</dd>
                    </div>
                }

                <div class="receipt-row">
                    <dt>Tax (10%)</dt>
                    <dd>RM @Model.Tax.ToString("N2")</dd>
                </div>
                <div class="receipt-row total-row">
                    <dt>Total Amount</dt>
                    <dd>RM @Model.Total.ToString("N2")</dd>
                </div>
            </dl>

            @if (Model.HasPromotionDiscount)
            {
                <div class="receipt-savings-callout" role="note" style="margin-bottom: 1.25rem;">
                    <svg viewBox="0 0 24 24" aria-hidden="true" class="savings-callout-icon">
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                    </svg>
                    <span>You saved <strong>RM @Model.TotalDiscount.ToString("N2")</strong> on this order!</span>
                </div>
            }

            <button class="receipt-view-button print-button" type="button" onclick="window.print()">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M6 9V3h12v6M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2M6 14h12v7H6z" />
                </svg>
                <span>Print Receipt</span>
            </button>
        </div>
    </dialog>

    <script>
        const receiptDialog = document.getElementById("receipt-dialog");
        document.getElementById("open-receipt").addEventListener("click", () => receiptDialog.showModal());
    </script>
</body>
</html>
