@page "/Dashboard"
@model RestaurantReservationAndOrderManagementSystem.Pages.DashboardModel
@{
}

<link rel="stylesheet" href="~/css/dashboard_page.css" />

<section class="dashboard">
  <!-- Page header -->
  <header>
    <h2>Dashboard Overview</h2>
  </header>

  <!-- Top stats cards -->
  <div class="stats-grid" aria-label="Top statistics">
    <div class="stat-card">
      <div class="stat-number">12</div>
      <div class="stat-label">Today's Active Orders</div>
    </div>
    <div class="stat-card">
      <div class="stat-number">8</div>
      <div class="stat-label">Today's Reservations</div>
    </div>
    <div class="stat-card">
      <div class="stat-number">6 / 12</div>
      <div class="stat-label">Available Tables</div>
    </div>
    <div class="stat-card">
      <div class="stat-number">4</div>
      <div class="stat-label">Occupied (On Dine)</div>
    </div>
  </div>

  <!-- Main two-column section -->
  <div class="main-grid">
    <!-- Left: Live Kitchen Orders Queue -->
    <section class="panel">
      <h3>Active Orders</h3>
      <div class="orders-list" aria-live="polite">
        <div class="order-item">
          <div class="order-meta"><strong>#907653</strong><span>Table T1</span><span>20:30</span></div>
          <div class="order-meta"><span>Items: 7</span><button class="order-action">Mark as Ready</button></div>
        </div>

        <div class="order-item">
          <div class="order-meta"><strong>#907654</strong><span>Table T2</span><span>20:35</span></div>
          <div class="order-meta"><span>Items: 4</span><button class="order-action">Mark as Ready</button></div>
        </div>

        <div class="order-item">
          <div class="order-meta"><strong>#907655</strong><span>Table T3</span><span>20:40</span></div>
          <div class="order-meta"><span>Items: 2</span><button class="order-action">Mark as Ready</button></div>
        </div>

        <!-- more order items... -->
      </div>
    </section>

    <!-- Right: Upcoming Reservations -->
    <aside class="panel">
      <h3>Upcoming Reservations</h3>
      <table class="reservations-table" aria-label="Today's reservations">
        <thead>
          <tr><th>Time</th><th>Name</th><th>Guests</th><th>Table</th><th>Status</th></tr>
        </thead>
        <tbody>
          <tr><td>12:30</td><td>John Doe</td><td>4</td><td>7</td><td class="status-available">Available</td></tr>
          <tr><td>13:00</td><td>Jane Smith</td><td>2</td><td>3</td><td class="status-reserved">Reserved</td></tr>
          <tr><td>18:00</td><td>Tim Lee</td><td>6</td><td>1</td><td class="status-ondine">On Dine</td></tr>
        </tbody>
      </table>
    </aside>
  </div>

  <!-- Bottom: Quick table occupancy overview -->
  <section class="panel">
    <h3>Table Status Overview</h3>
    <div class="tables-overview" aria-label="Table overview">
      <div class="table-box status-available">Table #1<br/><small>8 pax</small></div>
      <div class="table-box status-reserved">Table #2<br/><small>2 pax</small></div>
      <div class="table-box status-available">Table #3<br/><small>2 pax</small></div>
      <div class="table-box status-ondine">Table #4<br/><small>3 pax</small></div>
      <div class="table-box status-available">Table #5<br/><small>6 pax</small></div>
      <div class="table-box status-reserved">Table #6<br/><small>7 pax</small></div>
    </div>
  </section>
</section>
