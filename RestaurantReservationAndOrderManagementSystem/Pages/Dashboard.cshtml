@page "/Dashboard"
@model RestaurantReservationAndOrderManagementSystem.Pages.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
}

<link rel="stylesheet" href="~/css/dashboard_page.css" asp-append-version="true" />

<section class="dashboard" aria-label="Restaurant dashboard">
    <header class="dashboard-hero">
        <div>
            <p class="eyebrow">Good morning, Joshua</p>
            <h1>Let's make today delicious.</h1>
            <p class="hero-caption">Here's the little snapshot of everything happening at Between Bites.</p>
        </div>
        <span class="hero-icon" aria-hidden="true"><i class="fa-solid fa-mug-hot"></i></span>
    </header>

    <section class="stats-grid" aria-label="Today's statistics">
        <article class="stat-card">
            <div class="stat-heading"><span>Active orders</span><i class="fa-solid fa-receipt" aria-hidden="true"></i></div>
            <strong class="stat-number">12</strong>
            <span class="stat-note">3 ready for handoff</span>
        </article>
        <article class="stat-card">
            <div class="stat-heading"><span>Reservations</span><i class="fa-regular fa-calendar-days" aria-hidden="true"></i></div>
            <strong class="stat-number">08</strong>
            <span class="stat-note">Next one at 12:30 PM</span>
        </article>
        <article class="stat-card">
            <div class="stat-heading"><span>Tables available</span><i class="fa-solid fa-table-cells" aria-hidden="true"></i></div>
            <strong class="stat-number">06 / 12</strong>
            <span class="stat-note">Half the room is free</span>
        </article>
        <article class="stat-card">
            <div class="stat-heading"><span>Guests dining in</span><i class="fa-solid fa-user-group" aria-hidden="true"></i></div>
            <strong class="stat-number">24</strong>
            <span class="stat-note">A lovely lunch rush</span>
        </article>
    </section>

    <div class="main-grid">
        <section class="panel orders-panel" aria-labelledby="active-orders-title">
            <div class="panel-heading">
                <div>
                    <p class="eyebrow">Fresh from the kitchen</p>
                    <h2 id="active-orders-title">Active orders</h2>
                </div>
                <a class="panel-link" href="/Orders">See all</a>
            </div>
            <div class="orders-list" aria-live="polite">
                <article class="order-item">
                    <span class="order-icon" aria-hidden="true"><i class="fa-solid fa-receipt"></i></span>
                    <div class="order-details"><strong>#907653 · Sarah Kim</strong><span>Table T1 · 7 items</span></div>
                    <span class="order-status status-preparing">Preparing</span>
                    <i class="order-check fa-solid fa-check" aria-label="In progress"></i>
                </article>
                <article class="order-item">
                    <span class="order-icon" aria-hidden="true"><i class="fa-solid fa-receipt"></i></span>
                    <div class="order-details"><strong>#907654 · Marcus Lee</strong><span>Table T2 · 4 items</span></div>
                    <span class="order-status status-pending">Pending</span>
                    <i class="order-check fa-solid fa-check" aria-label="In progress"></i>
                </article>
                <article class="order-item">
                    <span class="order-icon" aria-hidden="true"><i class="fa-solid fa-receipt"></i></span>
                    <div class="order-details"><strong>#907655 · Nina Patel</strong><span>Table T5 · 3 items</span></div>
                    <span class="order-status status-ready">Ready to serve</span>
                    <i class="order-check fa-solid fa-check" aria-label="Ready"></i>
                </article>
            </div>
        </section>

        <section class="panel reservations-panel" aria-labelledby="upcoming-title">
            <div class="panel-heading">
                <div>
                    <p class="eyebrow">Save their seats</p>
                    <h2 id="upcoming-title">Coming up</h2>
                </div>
                <a class="panel-link" href="/Reservations">Open book</a>
            </div>
            <div class="reservation-list" aria-label="Today's reservations">
                <article class="reservation-item">
                    <time datetime="12:30">12:30</time>
                    <div><strong>John Doe</strong><span>4 guests · Table T7</span></div>
                    <span class="reservation-status">Arriving</span>
                </article>
                <article class="reservation-item">
                    <time datetime="13:00">13:00</time>
                    <div><strong>Jane Smith</strong><span>2 guests · Table T3</span></div>
                    <span class="reservation-status">Confirmed</span>
                </article>
                <article class="reservation-item">
                    <time datetime="18:00">18:00</time>
                    <div><strong>Tim Lee</strong><span>6 guests · Table T1</span></div>
                    <span class="reservation-status">On dine-in</span>
                </article>
            </div>
        </section>
    </div>

    <section class="panel tables-panel" aria-labelledby="table-checkin-title">
        <div class="panel-heading">
            <div>
                <p class="eyebrow">A peek at the room</p>
                <h2 id="table-checkin-title">Table check-in</h2>
            </div>
            <a class="panel-link" href="/Tables">Manage tables</a>
        </div>
        <div class="tables-overview" aria-label="Table occupancy overview">
            <div class="table-box table-busy"><span>T1 · 8 pax</span></div>
            <div class="table-box table-free"><span>T2 · 2 pax</span></div>
            <div class="table-box table-free"><span>T3 · 2 pax</span></div>
            <div class="table-box table-reserved"><span>T4 · 3 pax</span></div>
            <div class="table-box table-busy"><span>T5 · 6 pax</span></div>
            <div class="table-box table-free"><span>T6 · 7 pax</span></div>
        </div>
    </section>
</section>
