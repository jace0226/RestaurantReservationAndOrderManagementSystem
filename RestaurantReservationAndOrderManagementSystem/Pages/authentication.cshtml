@page "/Authenticate"
@model RestaurantReservationAndOrderManagementSystem.Pages.authenticationModel
@{
	Layout = null;
	ViewData["Title"] = "Sign in or sign up";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RestaurantReservationAndOrderManagementSystem</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/authentication_page.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RestaurantReservationAndOrderManagementSystem.styles.css" asp-append-version="true" />
</head>
<body>
	<div class="authentication-container">
		<form method="post" action="/Authenticate?handler=Login" id="loginForm" hidden="@(Model.ActiveForm != "login")">
			@Html.AntiForgeryToken()
			<input type="hidden" name="returnUrl" value="@Request.Query["ReturnUrl"]" />
			<div class="inner-container">
				<div class="form-header">
					<h2>Sign in</h2>
				</div>

				<div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
				<div class="form-input">
					<i class="fa-solid fa-envelope"></i>
					<input asp-for="Login.EmailOrPhone" type="text" autocomplete="username" placeholder="Email or phone number" />
				</div>
				<span asp-validation-for="Login.EmailOrPhone" class="text-danger"></span>
				<div class="form-input">
					<i class="fa-solid fa-key"></i>
					<input asp-for="Login.Password" autocomplete="current-password" placeholder="Password" />
				</div>
				<span asp-validation-for="Login.Password" class="text-danger"></span>

                <div class="captcha-group">
                    <div class="captcha-header">
                        <label asp-for="Login.CaptchaCode">Security check</label>
                        <button type="button" id="refreshCaptcha" class="captcha-refresh" aria-label="Generate a new CAPTCHA code" title="Generate a new CAPTCHA code">
                            <i class="fa-solid fa-rotate" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="captcha-image-row">
                        <img id="captchaImage" src="@Model.CaptchaImage" alt="CAPTCHA image containing six characters" />
                    </div>
                    <div class="form-input captcha-input">
                        <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
                        <input asp-for="Login.CaptchaCode" type="text" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="Enter 6-character code" maxlength="6" required />
                    </div>
                    <span asp-validation-for="Login.CaptchaCode" class="text-danger"></span>
                </div>
				<button type="submit">Sign in</button>
			</div>

			<span class="footer-text">Don't have an account? <button type="button" class="auth-switch" data-show="register">Sign up</button></span>
		</form>

		<form method="post" action="/Authenticate?handler=Register" id="registerForm" hidden="@(Model.ActiveForm != "register")">
			@Html.AntiForgeryToken()
			<div class="inner-container">
				<div class="form-header">
					<h2>Sign up</h2>
				</div>

				<div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
				<div class="form-input">
					<i class="fa-solid fa-user"></i>
					<input asp-for="Registration.FullName" autocomplete="name" placeholder="Full name" />
				</div>
				<span asp-validation-for="Registration.FullName" class="text-danger"></span>
				<div class="form-input">
					<i class="fa-solid fa-envelope"></i>
					<input asp-for="Registration.Email" type="email" autocomplete="email" placeholder="Email address" />
				</div>
				<span asp-validation-for="Registration.Email" class="text-danger"></span>
				<div class="form-input">
					<i class="fa-solid fa-key"></i>
					<input asp-for="Registration.Password" autocomplete="new-password" placeholder="Password" />
				</div>
				<span asp-validation-for="Registration.Password" class="text-danger"></span>
				<div class="form-input">
					<i class="fa-solid fa-key"></i>
					<input asp-for="Registration.ConfirmPassword" autocomplete="new-password" placeholder="Confirm password" />
				</div>
				<span asp-validation-for="Registration.ConfirmPassword" class="text-danger"></span>
				<div class="form-input">
					<i class="fa-solid fa-phone"></i>
					<input asp-for="Registration.Phone" type="tel" autocomplete="tel" placeholder="Phone number" />
				</div>
				<span asp-validation-for="Registration.Phone" class="text-danger"></span>
				<div class="form-input">
					<i class="fa-solid fa-calendar"></i>
					<input asp-for="Registration.DateOfBirth" type="date" max="@DateTime.Today.ToString("yyyy-MM-dd")" autocomplete="bday" />
				</div>
				<span asp-validation-for="Registration.DateOfBirth" class="text-danger"></span>
				<button type="submit">Create account</button>
			</div>

			<span class="footer-text">Already have an account? <button type="button" class="auth-switch" data-show="login">Sign in</button></span>
		</form>
	</div>

	<script>
		document.querySelectorAll(".auth-switch").forEach(button => {
			button.addEventListener("click", () => {
				const showRegister = button.dataset.show === "register";
				document.getElementById("loginForm").hidden = showRegister;
				document.getElementById("registerForm").hidden = !showRegister;
			});
		});
	</script>
	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<partial name="_ValidationScriptsPartial" />
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://kit.fontawesome.com/f3ce044c74.js" crossorigin="anonymous"></script>
	<script>
		const captchaImage = document.getElementById("captchaImage");
		const refreshCaptcha = document.getElementById("refreshCaptcha");

		refreshCaptcha?.addEventListener("click", async () => {
			refreshCaptcha.disabled = true;
			try {
				const response = await fetch("/Authenticate?handler=GenerateCaptcha", {
					cache: "no-store",
					headers: { "Accept": "image/svg+xml" }
				});
				if (!response.ok) {
					throw new Error("CAPTCHA refresh failed");
				}

				const imageBlob = await response.blob();
				const nextImageUrl = URL.createObjectURL(imageBlob);
				const previousImageUrl = captchaImage.src.startsWith("blob:") ? captchaImage.src : null;
				captchaImage.src = nextImageUrl;
				if (previousImageUrl) {
					URL.revokeObjectURL(previousImageUrl);
				}
			} finally {
				refreshCaptcha.disabled = false;
			}
		});
	</script>
	@if (TempData["RegisterSuccess"] is true)
	{
		<script>
			window.alert("Account registered successfully! Please sign in with your email, password, and CAPTCHA.");
			document.getElementById("Login_EmailOrPhone")?.focus();
		</script>
	}
</body>
</html>
